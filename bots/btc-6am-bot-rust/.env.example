# BTC 6am Bot
# Copie para .env e preencha somente os valores reais.
# Nunca comite o arquivo .env.

# Safety
# Trading real so acontece com DRY_RUN=false e ALLOW_LIVE_TRADING=true.
DRY_RUN=true
ALLOW_LIVE_TRADING=false

# Conta Polymarket
# Use eoa para wallet direta, proxy para conta do site, gnosis/safe quando aplicavel.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_SIGNATURE_TYPE=eoa

# Armazenamento
DATABASE_URL=
PAPER_TRADES_PATH=data/paper_trades.json
STRATEGY_VERSION=v1

# Estrategia
TARGET_HOUR_UTC=6
TRADE_DIRECTION=up
EXPECTED_WIN_RATE=0.578
# Obrigatorio para transformar a taxa historica em limite inferior de Wilson.
EXPECTED_WIN_RATE_SAMPLE_SIZE=0
EXPECTED_WIN_RATE_CONFIDENCE_Z=1.96
MIN_EDGE=0.02
MAX_ENTRY_PRICE=0.55
POSITION_SIZE_USDC=5.0
MIN_LIQUIDITY=500.0
MIN_ASK_SIZE_USD=5.0
BACKTEST_SLIPPAGE_BPS=50

# Timing
ENTRY_DELAY_SECS=5
ENTRY_WINDOW_SECS=300
POLL_INTERVAL_ACTIVE_SECS=10
POLL_INTERVAL_IDLE_SECS=60
MAX_DAILY_TRADES=12

# APIs publicas
GAMMA_BASE_URL=https://gamma-api.polymarket.com
CLOB_BASE_URL=https://clob.polymarket.com

# Logs
RUST_LOG=info
