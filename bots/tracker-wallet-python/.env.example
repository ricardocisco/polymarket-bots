# Polymarket Wallet Tracker
# Copie para .env e preencha somente os valores reais.
# Nunca comite o arquivo .env.

# Discord
DISCORD_TOKEN=
CLIENT_ID=

# MongoDB
# A versao TypeScript usa MONGO_URI. A versao Rust em rust/ usa MONGODB_URI.
MONGO_URI=mongodb://localhost:27017/polybot
MONGODB_URI=mongodb://localhost:27017/polybot
MONGODB_DB=polymarket_tracker

# API local TypeScript
PORT=3000

# DNS opcional para mongodb+srv:// quando o ambiente resolve SRV mal.
DNS_SERVERS=

# Logs TypeScript
LOG_LEVEL=INFO

# Logs Rust opcional
LOG_ENABLED=true
RUST_LOG=polymarket_tracker=info
