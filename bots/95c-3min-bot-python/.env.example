# Polymarket Sniper 95c
# Copie para .env e preencha somente os valores reais.
# Nunca comite o arquivo .env.

# Safety
# Trading real so acontece com DRY_RUN=false e ALLOW_LIVE_TRADING=true.
DRY_RUN=true
ALLOW_LIVE_TRADING=false

# Conta Polymarket
# Rust atual usa POLYMARKET_PRIVATE_KEY. Scripts Python legados usam PRIVATE_KEY.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_SIGNATURE_TYPE=proxy

# Opcional para scripts Python legados
PRIVATE_KEY=
FUNDER_ADDRESS=
SIGNATURE_TYPE=2
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Risco e entrada
BANKROLL=20.0
POSITION_SIZE_USDC=2.0
MIN_EDGE=0.04
MIN_ENTRY_PRICE=0.95
MAX_ENTRY_PRICE=0.995
MIN_MINUTES_LEFT=0.5
MAX_MINUTES_LEFT=3.0
MIN_ASK_SIZE_USD=1.0

# Loop e armazenamento
LOOP_INTERVAL=5
POLL_INTERVAL=5
PAPER_TRADES_PATH=data/paper_trades.json
STRATEGY_VERSION=rust-v2

# APIs publicas
GAMMA_BASE_URL=https://gamma-api.polymarket.com
CLOB_BASE_URL=https://clob.polymarket.com
BINANCE_BASE_URL=https://api.binance.com

# WebSocket Python legado (opcional)
USE_WEBSOCKET=false
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Logs
RUST_LOG=info
