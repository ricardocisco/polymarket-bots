# Polymarket Bayesian 5/15
# Copie para .env e preencha somente os valores reais.
# Nunca comite o arquivo .env.

# Safety
# Trading real so acontece com DRY_RUN=false e ALLOW_LIVE_TRADING=true.
DRY_RUN=true
BAYESIAN_DRY_RUN=true
ALLOW_LIVE_TRADING=false

# Conta Polymarket
# A versao Rust atual aceita: eoa, proxy, poly_proxy, gnosis, gnosis_safe, safe.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_SIGNATURE_TYPE=proxy

# Opcional para scripts Python legados
# Na versao Python, POLYMARKET_SIGNATURE_TYPE deve ser numerico: 0, 1 ou 2.
PRIVATE_KEY=
POLYMARKET_FUNDER=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=

# Perfil e banca
BAYESIAN_MODE=CONSERVATIVE
TRADING_MODE=CONSERVATIVE
BAYESIAN_BANKROLL=20
BANKROLL=20
BAYESIAN_FLAT_STAKE_USDC=0

# Filtros de entrada
BAYESIAN_MIN_BUY_PRICE=0.50
BAYESIAN_MAX_BUY_PRICE=0.58
BAYESIAN_MIN_ASK_SIZE_USD=5.0
LOOP_INTERVAL=5

# Armazenamento
PAPER_TRADES_PATH=data/paper_trades.json
LOG_DIR=logs
STRATEGY_VERSION=rust-bayes-v1

# APIs publicas
GAMMA_BASE_URL=https://gamma-api.polymarket.com
CLOB_BASE_URL=https://clob.polymarket.com
BINANCE_BASE_URL=https://api.binance.com

# Logs
RUST_LOG=info
