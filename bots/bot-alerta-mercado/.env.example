# Webhook do canal do Discord. Crie em:
# Configuracoes do canal > Integracoes > Webhooks > Novo webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Link do mercado/evento. O bot extrai o slug do evento automaticamente.
EVENT_URL=https://polymarket.com/event/brazil-presidential-election

# Intervalo de checagem. A Gamma API tem limite alto, mas 60s costuma ser um bom ponto.
POLL_INTERVAL_SECONDS=60

# true evita cache de 5 minutos no endpoint da Gamma API.
BYPASS_CACHE=true

# false evita mandar uma avalanche de alertas na primeira execucao.
NOTIFY_ON_FIRST_RUN=false

# true imprime o payload no terminal sem enviar ao Discord.
DRY_RUN=false

# Opcional: mencao do Discord, como <@123>, <@&123> ou @here.
DISCORD_MENTION=

# Onde guardar o ultimo snapshot visto.
STATE_FILE=data/state.json
