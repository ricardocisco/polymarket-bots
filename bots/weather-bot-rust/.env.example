# =============================================================
#  polymarket-weather-bot — Configuração
#  cp .env.example .env   →   edite com seus valores reais
#  NUNCA comite o .env no git!
# =============================================================

# Chave privada da wallet Polygon (hex, sem prefixo 0x)
# Esta wallet precisa ter USDC na Polymarket (Polygon mainnet)
POLYMARKET_PRIVATE_KEY=cole_sua_chave_privada_aqui

# Confiança mínima da previsão para entrar numa posição (0.0 – 1.0)
# 0.98 = exige 98% de confiança. Recomendado: 0.95 – 0.99
MIN_CONFIDENCE=0.98

# Tamanho máximo de posição por mercado em USDC
MAX_POSITION_SIZE_USDC=10.0

# Tamanho mínimo de ordem em USDC (Polymarket recomenda >= 1.0)
MIN_ORDER_SIZE_USDC=1.0

# Intervalo entre ciclos de execução em segundos
# 3600 = executa a cada hora
RUN_INTERVAL_SECS=3600

# URL de conexão com PostgreSQL (opcional — para persistir trades no banco de dados)
# Mesmo banco do first-minute-followthrough-rust: first_minute_followthrough
# Tabela criada automaticamente: weather_paper_trades
# Deixe em branco para rodar sem banco de dados (só JSON).
DATABASE_URL=postgres://postgres:1234@localhost:5432/first_minute_followthrough

# Nível de logging: error | warn | info | debug | trace
RUST_LOG=bot=info,warn

# =============================================================
#  Estratégia Multi-Source + Cross-Market (@providerx-style)
# =============================================================

# Número mínimo de fontes que devem responder para calcular consensus
# (de 6 fontes disponíveis: GFS, ICON, ECMWF, Ensemble, TAF, Wunderground)
NUM_SOURCES_REQUIRED=3

# Spread máximo entre fontes (em graus) para considerar o consensus confiável
# Se fontes discordam mais que isso, o bot não entra
# Ex: 1.5 = fontes devem estar todas dentro de 1.5°C entre si
SOURCE_AGREEMENT_THRESHOLD=1.5

# Confiança mínima do consensus para ativar a estratégia cross-market
# Esta confiança é calculada com base no horizonte + spread + acordo entre fontes
CONSENSUS_MIN_CONFIDENCE=0.80

# Preço máximo do NO para entrar no penny play (bins adjacentes)
# 0.15 = só entra se NO estiver cotado a ≤ 15¢
PENNY_NO_MAX_PRICE=0.15

# Raio de bins adjacentes a considerar para NO penny play
# 2 = considera até 2 bins acima e abaixo do bin com a temperatura prevista
CROSS_MARKET_BINS_RADIUS=2
